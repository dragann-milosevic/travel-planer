<?xml version="1.0" encoding="utf-8"?>
<StartupServicesManifest xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://schemas.microsoft.com/2011/01/fabric">
  <Parameters>
    <Parameter Name="NotificationService_MinReplicaSetSize" DefaultValue="3" />
    <Parameter Name="NotificationService_PartitionCount" DefaultValue="1" />
    <Parameter Name="NotificationService_TargetReplicaSetSize" DefaultValue="3" />
    <Parameter Name="TravelPlanService_InstanceCount" DefaultValue="-1" />
    <Parameter Name="AuthService_InstanceCount" DefaultValue="-1" />
  </Parameters>
  <Services>
    <Service Name="NotificationService" ServicePackageActivationMode="ExclusiveProcess">
      <StatefulService ServiceTypeName="NotificationServiceType" TargetReplicaSetSize="[NotificationService_TargetReplicaSetSize]" MinReplicaSetSize="[NotificationService_MinReplicaSetSize]">
        <UniformInt64Partition PartitionCount="[NotificationService_PartitionCount]" LowKey="-9223372036854775808" HighKey="9223372036854775807" />
      </StatefulService>
    </Service>
    <Service Name="TravelPlanService" ServicePackageActivationMode="ExclusiveProcess">
      <StatelessService ServiceTypeName="TravelPlanServiceType" InstanceCount="[TravelPlanService_InstanceCount]">
        <SingletonPartition />
      </StatelessService>
    </Service>
    <Service Name="AuthService" ServicePackageActivationMode="ExclusiveProcess">
      <StatelessService ServiceTypeName="AuthServiceType" InstanceCount="[AuthService_InstanceCount]">
        <SingletonPartition />
      </StatelessService>
    </Service>
  </Services>
</StartupServicesManifest>